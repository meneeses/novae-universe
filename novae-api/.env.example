PORT=3333
NOVAE_JWT_SECRET=your_jwt_secret_here
NOVAE_SUPABASE_URL=https://xxxx.supabase.co
NOVAE_SUPABASE_KEY=your_service_role_key
# Supabase Settings > Database > Connection string > URI
# URL-encode the password before pasting it here if it contains reserved characters.
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres?sslmode=no-verify
DATABASE_URL_POOL=postgresql://postgres.[project]:[password]@aws-1-us-east-2.pooler.supabase.com:5432/postgres?sslmode=no-verify
GITHUB_TOKEN=your_github_token
FRONTEND_URL=http://localhost:5173
